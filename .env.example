HOPSTATS_BIND_ADDRESS=127.0.0.1
HOPSTATS_PORT=8000
HOPSTATS_HOST=127.0.0.1
# Local default; Docker Compose overrides this with the persistent /data path.
HOPSTATS_DATABASE_URL=sqlite:///./hopstats.sqlite3
HOPSTATS_LOG_LEVEL=info
HOPSTATS_MAX_UPLOAD_BYTES=10485760
# Untappd check-in exports may omit timezone data; naive timestamps use this zone.
HOPSTATS_IMPORT_DEFAULT_TIMEZONE=UTC
# Set true whenever the browser reaches HopStats over HTTPS (including a Cloudflare Tunnel).
# Keep false only for trusted local HTTP development.
HOPSTATS_COOKIE_SECURE=false
HOPSTATS_COOKIE_SAMESITE=lax
HOPSTATS_SESSION_MAX_AGE_SECONDS=2592000
# Comma-separated browser origins when a reverse proxy terminates TLS.
# HOPSTATS_ALLOWED_ORIGINS=https://hopstats.example.com
# Optional private JSON location hierarchy and alias/rule configuration.
# HOPSTATS_LOCATION_CONFIG=/run/secrets/hopstats-locations.json
# Prefer the immutable account ID when more than one account exists.
# HOPSTATS_LOCATION_CONFIG_USER_ID=1
# For initial provisioning only, a username may identify the owner instead.
# HOPSTATS_LOCATION_CONFIG_USERNAME=owner
